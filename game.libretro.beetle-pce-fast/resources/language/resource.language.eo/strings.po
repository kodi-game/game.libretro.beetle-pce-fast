msgid "No Sprite Limit"
msgstr "Sen limo de \"sprites\""

msgctxt "#30030"
msgid "CPU Overclock Multiplier (Restart Required)"
msgstr "Obligilo de ĉefprocesora trorapidigo (bezonas restaratigon)"

