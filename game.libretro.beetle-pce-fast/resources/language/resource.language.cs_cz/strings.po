msgid "2x"
msgstr "2x"

msgctxt "#30078"
msgid "4x"
msgstr "4x"

msgctxt "#30079"
msgid "8x"
msgstr "8x"

msgctxt "#30080"
msgid "CD game only. Setting this volume control too high may cause sample clipping."
msgstr "Pouze hra na CD. Příliš vysoké nastavení tohoto ovladače hlasitosti může způsobit oříznutí vzorku."

msgctxt "#30081"
msgid "CD game only. Applies a low-pass filter to CD ADPCM sample playback, reducing high-frequency aliasing/harshness. The cutoff scales with the ADPCM sample rate."
msgstr "Pouze hra z CD. Na přehrávání vzorků CD ADPCM použije dolní propust, která omezuje aliasing / ostrost vysokých frekvencí. Mezní frekvence se škáluje podle vzorkovací frekvence ADPCM."

msgctxt "#30082"
msgid "Ignore EDC/L-EC errors. Needed for compatibility with some hacks."
msgstr "Ignorovat chyby EDC/L-EC. Potřebné pro kompatibilitu s některými úpravami."

