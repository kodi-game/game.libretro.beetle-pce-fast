msgstr "스프라이트 제한 해제"

msgctxt "#30030"
msgid "CPU Overclock Multiplier (Restart Required)"
msgstr "CPU 오버클럭 배율 (재시작 필요)"

msgctxt "#30031"
msgid "CD Ignore EDC/L-EC Errors"
msgstr "CD EDC/L-EC 오류 무시"

